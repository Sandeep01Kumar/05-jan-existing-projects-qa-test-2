{
    "source": {
        "include": ["./server.js"],
        "includePattern": ".+\\.js(doc|x)?$",
        "excludePattern": "(node_modules|docs-output)"
    },
    "plugins": [
        "plugins/markdown"
    ],
    "opts": {
        "destination": "./docs-output",
        "recurse": true,
        "readme": "./README.md"
    },
    "templates": {
        "cleverLinks": false,
        "monospaceLinks": false
    }
}
